# Mobile app environment variables (Expo reads EXPO_PUBLIC_* at build time).
# Copy this to `.env` and fill in the values from Google Cloud Console.

# Backend host (leave unset for local dev → defaults to http://localhost:8080)
# EXPO_PUBLIC_DOMAIN=your-api-host.example.com

# ── Google sign-in client IDs ───────────────────────────────────────────────
# Create OAuth 2.0 Client IDs in Google Cloud Console (one per platform).
# The "Web" client ID is also used by Expo for the ID-token flow.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx-web.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx-ios.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx-android.apps.googleusercontent.com
